---
import { terms, whatsappUrl } from '../data/company';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Send your tech pack or a reference photo',
  text = `You get a written ${terms.incoterm} quote with sample cost and lead time within ${terms.quoteHours} hours, straight from the factory.`,
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-heading">
  <div class="cta-band__inner container">
    <div class="cta-band__copy">
      <h2 id="cta-heading" class="cta-band__heading">{heading}</h2>
      <p class="cta-band__text">{text}</p>
    </div>
    <div class="cta-band__actions">
      <a class="button button--primary" href="/get-a-quote/">Get a quote</a>
      <a class="button cta-band__secondary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp us<span class="visually-hidden"> (opens in a new tab)</span></a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    margin-top: var(--space-8);
    padding-block: var(--space-7);
    border-top: 1px solid var(--color-accent-strong);
    background: var(--color-surface-alt);
    border-block: 1px solid var(--color-line);
  }

  .cta-band__inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .cta-band__copy {
    display: grid;
    gap: var(--space-2);
    max-width: 40rem;
  }

  .cta-band__text {
    color: var(--color-muted);
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cta-band__secondary {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .cta-band__secondary:hover {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  @media (min-width: 64rem) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>
