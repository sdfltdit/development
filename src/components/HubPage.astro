---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from './PageHeader.astro';
import FactStrip from './FactStrip.astro';
import CtaBand from './CtaBand.astro';
import { fill } from '../data/company';
import { pageMeta } from '../data/pages';
import { itemList, standardPage, type Crumb } from '../lib/schema';

interface Group {
  heading: string;
  kinds: ('product' | 'service' | 'model' | 'guide')[];
}

interface Props {
  path: string;
  crumbLabel: string;
  eyebrow: string;
  heading: string;
  lead: string;
  groups: Group[];
  hub: 'products' | 'services';
}

const { path, crumbLabel, eyebrow, heading, lead, groups, hub } = Astro.props;
const meta = pageMeta(path);
const entries = (await getCollection('landing')).sort((a, b) => a.data.navLabel.localeCompare(b.data.navLabel));
const sections = groups.map((group) => ({
  heading: group.heading,
  items: entries.filter((e) => group.kinds.includes(e.data.kind) && e.data.hub === hub),
}));
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: crumbLabel, path },
];
const listed = sections.flatMap((s) => s.items).map((e) => ({ name: e.data.navLabel, path: `/${e.id}/` }));

const schema = standardPage({
  path,
  title: meta.title,
  description: meta.description,
  dateModified: meta.updated,
  crumbs,
  type: 'CollectionPage',
  extra: [itemList(path, listed)],
});
---

<BaseLayout title={meta.title} description={meta.description} path={path} schema={schema} crumbs={crumbs}>
  <PageHeader eyebrow={eyebrow} title={heading} lead={lead} updated={meta.updated}>
    <FactStrip keys={['moq', 'sample', 'bulk', 'quote']} />
  </PageHeader>

  {
    sections
      .filter((s) => s.items.length > 0)
      .map((section, index) => (
        <section class:list={['section', { 'section--alt': index % 2 === 1 }]} aria-label={section.heading}>
          <div class="container">
            <h2 class="block-heading">{section.heading}</h2>
            <ul class="cards">
              {section.items.map((item) => (
                <li class="card">
                  <h3 class="card__title">{item.data.navLabel}</h3>
                  <p class="card__text">{fill(item.data.cardSummary)}</p>
                  <a class="card__link" href={`/${item.id}/`}>
                    {item.data.navLabel}: details and terms
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
  }

  <section class="section">
    <div class="container prose">
      <slot />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
