---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from './PageHeader.astro';
import FactStrip from './FactStrip.astro';
import CtaBand from './CtaBand.astro';
import { fill } from '../data/company';
import { pageMeta } from '../data/pages';
import { faqPage, itemList, standardPage, type Crumb } from '../lib/schema';

import FaqList from './FaqList.astro';
import type { CatalogueGroup } from '../data/catalogue';

interface Props {
  path: string;
  crumbLabel: string;
  eyebrow: string;
  heading: string;
  lead: string;
  groups: CatalogueGroup[];
  hub: 'products' | 'services' | 'guides';
  faqs?: { q: string; a: string }[];
  faqHeading?: string;
}

const { path, crumbLabel, eyebrow, heading, lead, groups, hub, faqs = [], faqHeading = 'Questions' } = Astro.props;
const meta = pageMeta(path);
const entries = (await getCollection('landing')).filter((e) => (hub === 'guides' ? e.data.kind === 'guide' : e.data.hub === hub && e.data.kind !== 'guide'));
const bySlug = new Map(entries.map((e) => [e.id, e]));
const grouped = groups.flatMap((g) => g.slugs);
const missing = entries.filter((e) => !grouped.includes(e.id)).map((e) => e.id);
const unknown = grouped.filter((slug) => !bySlug.has(slug));
const twice = grouped.filter((slug, i) => grouped.indexOf(slug) !== i);
if (missing.length || unknown.length || twice.length) {
  throw new Error(`Hub ${path}: missing ${missing.join(', ') || 'none'}; unknown ${unknown.join(', ') || 'none'}; listed twice ${twice.join(', ') || 'none'}. Fix src/data/catalogue.ts.`);
}
const sections = groups.map((group) => ({ ...group, items: group.slugs.map((slug) => bySlug.get(slug)!) }));
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: crumbLabel, path },
];
const listed = sections.flatMap((s) => s.items).map((e) => ({ name: e.data.navLabel, path: `/${e.id}/` }));

const schema = standardPage({
  path,
  title: meta.title,
  description: meta.description,
  dateModified: meta.updated,
  crumbs,
  type: 'CollectionPage',
  extra: [itemList(path, listed), ...(faqs.length ? [faqPage(path, faqs)] : [])],
});
---

<BaseLayout title={meta.title} description={meta.description} path={path} schema={schema} crumbs={crumbs}>
  <PageHeader eyebrow={eyebrow} title={heading} lead={lead} updated={meta.updated}>
    <FactStrip keys={['moq', 'sample', 'bulk', 'quote']} />
  </PageHeader>

  {
    sections.length > 3 && (
      <nav class="hub-nav container" aria-label="Jump to a group">
        <ul class="hub-nav__list">
          {sections.map((section) => (
            <li>
              <a class="hub-nav__link" href={`#${section.id}`}>
                {section.heading} <span class="hub-nav__count">({section.items.length})</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    sections.map((section, index) => (
      <section class:list={['section', { 'section--alt': index % 2 === 1 }]} id={section.id} aria-labelledby={`${section.id}-heading`}>
        <div class="container">
          <div class="section__head">
            <h2 id={`${section.id}-heading`}>{section.heading}</h2>
            <p class="section__lead">{section.lead}</p>
          </div>
          <ul class="cards">
            {section.items.map((item) => (
              <li class="card">
                <h3 class="card__title">{item.data.navLabel}</h3>
                <p class="card__text">{fill(item.data.cardSummary)}</p>
                <a class="card__link" href={`/${item.id}/`}>
                  {item.data.linkText ?? `${item.data.navLabel}: details and terms`}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="container prose">
      <slot />
    </div>
  </section>

  {
    faqs.length > 0 && (
      <section class="section section--alt">
        <div class="container">
          <FaqList items={faqs} heading={faqHeading} />
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>
