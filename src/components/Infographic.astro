---
import { infographicMeta, type InfographicName } from '../lib/infographics';

interface Props {
  name: InfographicName;
  eager?: boolean;
  caption?: string;
}

const { name, eager = false, caption } = Astro.props;
const meta = infographicMeta[name];
const alt = meta.alt();
---

<figure class="infographic">
  <img
      class="infographic__img"
      src={`/images/infographics/${name}-dark.svg`}
      width={meta.width}
      height={meta.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : undefined}
    />
  {caption && <figcaption class="infographic__caption">{caption}</figcaption>}
</figure>

<style>
  .infographic {
    margin: 0;
  }

  .infographic__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  .infographic__caption {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
</style>
