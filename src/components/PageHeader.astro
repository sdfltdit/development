---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  updated?: string;
}

const { eyebrow, title, lead, updated } = Astro.props;
const updatedHuman = updated
  ? new Date(updated).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : undefined;
---

<header class="page-header container">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="page-header__title">{title}</h1>
  <p class="page-header__lead">{lead}</p>
  <slot />
  {updated && <p class="page-header__updated">Last updated <time datetime={updated}>{updatedHuman}</time></p>}
</header>

<style>
  .page-header {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-6);
  }

  .page-header__title {
    max-width: 24ch;
  }

  .page-header__lead {
    max-width: 44rem;
    font-size: var(--text-lg);
  }

  .page-header__updated {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
</style>
