---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from './PageHeader.astro';
import { pageMeta } from '../data/pages';
import { standardPage, type Crumb } from '../lib/schema';

interface Props {
  path: string;
  crumbLabel: string;
  eyebrow: string;
  heading: string;
  lead: string;
}

const { path, crumbLabel, eyebrow, heading, lead } = Astro.props;
const policies = [
  { href: '/privacy/', label: 'SDF Clothing privacy policy' },
  { href: '/cookies/', label: 'SDF Clothing cookie policy' },
  { href: '/terms/', label: 'SDF Clothing terms of use' },
  { href: '/accessibility/', label: 'SDF Clothing accessibility statement' },
  { href: '/editorial-policy/', label: 'SDF Clothing editorial policy' },
];
const others = policies.filter((p) => p.href !== path);
const isPolicy = others.length < policies.length;
const meta = pageMeta(path);
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: crumbLabel, path },
];
const schema = standardPage({
  path,
  title: meta.title,
  description: meta.description,
  dateModified: meta.updated,
  crumbs,
});
---

<BaseLayout title={meta.title} description={meta.description} path={path} schema={schema} crumbs={crumbs} noindex={meta.noindex}>
  <PageHeader eyebrow={eyebrow} title={heading} lead={lead} updated={meta.updated} />
  <section class="section prose-page">
    <div class="container prose">
      <slot />
      {
        isPolicy && (
          <nav class="policy-nav" aria-labelledby="policy-nav-heading">
            <h2 id="policy-nav-heading">Our other policies</h2>
            <ul>
              {others.map((p) => (
                <li>
                  <a href={p.href}>{p.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .prose-page {
    padding-top: 0;
  }
</style>
