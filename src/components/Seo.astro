---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { company, site } from '../data/company';
import { absolute } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  schema?: string;
}

const {
  title,
  description,
  path,
  noindex = false,
  ogType = 'website',
  ogImage,
  ogImageAlt,
  schema,
} = Astro.props;

const ogSlug = path.replace(/^\/|\/$/g, '').replaceAll('/', '--') || 'home';
const pageOgImage = `/og/${ogSlug}.png`;
const hasPageImage = !ogImage && existsSync(join(process.cwd(), 'public', pageOgImage));
const imagePath = ogImage ?? (hasPageImage ? pageOgImage : site.defaultOgImage);
const imageAlt = ogImageAlt ?? (hasPageImage ? title : `${company.brandName} – custom clothing manufacturer for brands worldwide`);

const canonical = absolute(path);
const image = absolute(imagePath);
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={company.brandName} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
{schema && <script type="application/ld+json" set:html={schema} />}
