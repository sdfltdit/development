---
import { company, terms, whatsappUrl } from '../data/company';
import { footerNav, legalNav } from '../data/nav';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__brand">
      <img class="site-footer__logo" src="/logo-badge.svg" alt="SDF Clothing logo" width="96" height="96" loading="lazy" decoding="async" />
      <p class="site-footer__name">{company.legalName}</p>
      <p class="site-footer__about">
        Garment factory in Dhaka since {company.foundingYear}, making custom clothing for brands worldwide from {terms.moq} {terms.moqUnit}.
      </p>
      <address class="site-footer__address">
        {company.address.street}<br />
        {company.address.locality} {company.address.postalCode}, {company.address.countryName}
      </address>
      <ul class="site-footer__contact">
        <li><a href={company.contactPath}>Send us a message</a></li>
        <li><a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Ask our WhatsApp assistant<span class="visually-hidden"> (opens in a new tab)</span></a></li>
      </ul>
      {company.showRegistration && <p class="site-footer__reg">RJSC reg. {company.registration.rjsc}</p>}
      <p class="site-footer__official">
        Our only website is <strong>{company.officialDomain}</strong> and we only email from <strong>@{company.officialDomain}</strong>.
        <a href="/verify-us/">How to verify us</a>
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      {
        footerNav.map((group) => (
          <details class="site-footer__group" data-footer-group open>
            <summary class="site-footer__heading">{group.label}</summary>
            <ul class="site-footer__links">
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </nav>
  </div>
  <div class="site-footer__base container">
    <p>
      © {year}
      {company.legalName}. All rights reserved. <span class="site-footer__parent">Part of {company.parentCompany}.</span>
    </p>
    <nav aria-label="Legal">
      <ul class="site-footer__legal">
        {
          legalNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<script is:inline>
  (function () {
    var desktop = window.matchMedia('(min-width: 48rem)');
    var groups = document.querySelectorAll('[data-footer-group]');
    function sync() {
      for (var i = 0; i < groups.length; i++) groups[i].open = desktop.matches;
    }
    sync();
    desktop.addEventListener('change', sync);
  })();
</script>

<style>
  .site-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-accent-strong);
    background: var(--color-bg);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .site-footer a {
    color: var(--color-text);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
  }

  .site-footer__brand {
    display: grid;
    gap: var(--space-3);
    max-width: 26rem;
  }

  .site-footer__logo {
    display: block;
    width: clamp(4.5rem, 4rem + 2vw, 6rem);
    height: auto;
    aspect-ratio: 1;
  }

  .site-footer__name {
    color: var(--color-ink);
    font-weight: 600;
  }

  .site-footer__about {
    max-width: 34ch;
  }

  .site-footer__address {
    font-style: normal;
  }

  .site-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__contact a,
  .site-footer__links a {
    display: flex;
    align-items: center;
    min-height: var(--touch);
  }

  .site-footer__official {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--color-accent-strong);
    border-radius: var(--radius-md);
  }

  .site-footer__official a {
    text-decoration: underline;
    text-decoration-color: var(--color-accent-strong);
  }

  .site-footer__nav {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .site-footer__group {
    border-bottom: 1px solid var(--color-line);
  }

  .site-footer__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    color: var(--color-ink);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .site-footer__heading::-webkit-details-marker {
    display: none;
  }

  .site-footer__heading::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1px solid var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.2s ease;
  }

  .site-footer__group[open] > .site-footer__heading::after {
    transform: rotate(-135deg) translateY(-2px);
  }

  .site-footer__links {
    padding-bottom: var(--space-3);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
  }

  .site-footer__legal a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }

  .site-footer__parent {
    font-size: var(--text-xs);
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-xs);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__heading::after {
      transition: none;
    }
  }

  @media (min-width: 48rem) {
    .site-footer__nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-5);
      border-top: 0;
    }

    .site-footer__group {
      border-bottom: 0;
    }

    .site-footer__heading {
      min-height: auto;
      margin-bottom: var(--space-3);
      padding-bottom: var(--space-2);
      border-bottom: 1px solid var(--color-accent-strong);
      cursor: default;
      pointer-events: none;
    }

    .site-footer__heading::after {
      display: none;
    }

    .site-footer__links a {
      min-height: auto;
      padding-block: var(--space-2);
      line-height: 1.4;
    }
  }

  @media (min-width: 64rem) {
    .site-footer__inner {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-7);
    }
  }
</style>
