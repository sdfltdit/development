---
import { company, visitPurposes } from '../data/company';

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const id = (name: string) => `visit-${name}`;
---

<form class="lead-form" action="/api/booking" method="post" novalidate data-lead-form data-contact={company.contactPath}>
  <div class="lead-form__grid">
    <div class="field">
      <label class="field__label" for={id('name')}>Your name <span class="field__req">required</span></label>
      <input class="field__input" id={id('name')} name="name" type="text" autocomplete="name" required minlength="2" maxlength="100" aria-describedby={id('name-error')} />
      <p class="field__error" id={id('name-error')} aria-live="polite"></p>
    </div>

    <div class="field">
      <label class="field__label" for={id('email')}>Work email <span class="field__req">required</span></label>
      <input class="field__input" id={id('email')} name="email" type="email" autocomplete="email" required maxlength="160" aria-describedby={id('email-error')} />
      <p class="field__error" id={id('email-error')} aria-live="polite"></p>
    </div>

    <div class="field">
      <label class="field__label" for={id('company')}>Brand or company</label>
      <input class="field__input" id={id('company')} name="company" type="text" autocomplete="organization" maxlength="120" />
    </div>

    <div class="field">
      <label class="field__label" for={id('country')}>Country you are travelling from <span class="field__req">required</span></label>
      <input class="field__input" id={id('country')} name="country" type="text" autocomplete="country-name" required maxlength="80" aria-describedby={id('country-error')} />
      <p class="field__error" id={id('country-error')} aria-live="polite"></p>
    </div>

    <div class="field">
      <label class="field__label" for={id('date1')}>Preferred date <span class="field__req">required</span></label>
      <input class="field__input" id={id('date1')} name="date1" type="date" required aria-describedby={id('date1-error')} />
      <p class="field__error" id={id('date1-error')} aria-live="polite"></p>
    </div>

    <div class="field">
      <label class="field__label" for={id('date2')}>Alternative date</label>
      <input class="field__input" id={id('date2')} name="date2" type="date" aria-describedby={id('date2-error')} />
      <p class="field__error" id={id('date2-error')} aria-live="polite"></p>
    </div>

    <div class="field">
      <label class="field__label" for={id('visitors')}>Number of visitors <span class="field__req">required</span></label>
      <input class="field__input" id={id('visitors')} name="visitors" type="number" inputmode="numeric" min="1" max="10" step="1" value="1" required aria-describedby={id('visitors-error')} />
      <p class="field__error" id={id('visitors-error')} aria-live="polite"></p>
    </div>

    <div class="field">
      <label class="field__label" for={id('purpose')}>Purpose of the visit <span class="field__req">required</span></label>
      <select class="field__input" id={id('purpose')} name="purpose" required>
        {visitPurposes.map((p) => <option value={p}>{p}</option>)}
      </select>
    </div>
  </div>

  <div class="field">
    <label class="field__label" for={id('message')}>Anything we should prepare?</label>
    <textarea class="field__input field__textarea" id={id('message')} name="message" maxlength="2000" rows="4" placeholder="Products you want to discuss, samples to review, or a quote reference"></textarea>
  </div>

  <div class="lead-form__trap" aria-hidden="true">
    <label for={id('fax')}>Leave this field empty</label>
    <input id={id('fax')} name="fax" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <label class="field__option">
      <input type="checkbox" name="consent" value="yes" required aria-describedby={id('consent-error')} />
      <span>I agree that SDF Clothing may use these details to arrange my visit, as described in the <a href="/privacy/">privacy policy</a>.</span>
    </label>
    <p class="field__error" id={id('consent-error')} aria-live="polite"></p>
  </div>

  {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-size="flexible"></div>}

  <div class="lead-form__submit">
    <button class="button button--primary" type="submit" data-submit>
      <span class="lead-form__spinner" aria-hidden="true"></span>
      <span data-submit-label>Request my visit</span>
    </button>
    <p class="lead-form__note">We confirm the date by email from an @{company.officialDomain} address.</p>
  </div>

  <p class="lead-form__status" role="status" aria-live="polite" data-status></p>
</form>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import '../scripts/lead-form';
</script>
