---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FactStrip from '../components/FactStrip.astro';
import FaqList from '../components/FaqList.astro';
import PriceTable from '../components/PriceTable.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, fill } from '../data/company';
import { linkCards } from '../lib/links';
import { article, breadcrumbList, faqPage, founder, graph, organization, service, webPage, website, type Crumb } from '../lib/schema';

export async function getStaticPaths() {
  /** Landing entries with their own dedicated page in src/pages. */
  const dedicated = new Set(['t-shirt-manufacturer', 'hoodie-manufacturer', 'joggers-manufacturer', 'pants-trousers-manufacturer', 'shorts-manufacturer', 'shirt-manufacturer', 'jacket-manufacturer', 'activewear-manufacturer', 'leggings-manufacturer', 'tracksuit-manufacturer', 'streetwear-manufacturer', 'dress-manufacturer', 'skirts-manufacturer', 'loungewear-manufacturer', 'kids-baby-clothing-manufacturer', 'uniform-manufacturer', 'underwear-manufacturer', 'clothing-manufacturers-for-women', 'plus-size-clothing-manufacturer', 'modest-fashion-manufacturer', 'merch-manufacturer', 'school-uniform-manufacturer', 'scrubs-manufacturer', 'cotton-clothing-manufacturer', 'linen-clothing-manufacturer', 'bamboo-clothing-manufacturer', 'denim-manufacturer', 'swimwear-manufacturer', 'sports-bra-manufacturer', 'puffer-jacket-manufacturer', 'blazer-manufacturer', 'socks-manufacturer', 'sweater-manufacturer', 'hat-manufacturer', 'lingerie-manufacturer', 'rain-jacket-manufacturer', 'varsity-jacket-manufacturer', 'fleece-jacket-manufacturer', 'softshell-jacket-manufacturer', 'coat-manufacturer', 'football-kit-manufacturer', 'basketball-uniform-manufacturer', 'cycling-jersey-manufacturer', 'rugby-shirt-manufacturer', 'baseball-uniform-manufacturer', 'esports-jersey-manufacturer', 'cheerleading-uniform-manufacturer', 'dancewear-manufacturer', 'martial-arts-uniform-manufacturer', 'fightwear-manufacturer', 'golf-apparel-manufacturer', 'tennis-wear-manufacturer', 'running-apparel-manufacturer', 'compression-wear-manufacturer', 'base-layer-manufacturer', 'ski-wear-manufacturer', 'chef-uniform-manufacturer', 'apron-manufacturer', 'lab-coat-manufacturer', 'coverall-manufacturer', 'hi-vis-workwear-manufacturer', 'security-uniform-manufacturer', 'hotel-uniform-manufacturer', 'jumpsuit-romper-manufacturer', 'maternity-clothing-manufacturer', 'silk-pillowcase-manufacturer', 'sleep-mask-manufacturer', 'embroidered-patch-manufacturer', 'pet-clothing-manufacturer', 'cushion-cover-manufacturer', 'dust-bag-manufacturer', 'tote-bag-manufacturer', 'cosmetic-pouch-manufacturer', 'drawstring-bag-manufacturer', 'scarf-manufacturer', 'bandana-manufacturer', 'neck-gaiter-manufacturer', 'hair-accessories-manufacturer', 'tie-manufacturer', 'baby-bib-manufacturer', 'tea-towel-manufacturer', 'table-linen-manufacturer', 'gloves-manufacturer', 'shapewear-manufacturer', 'evening-dress-manufacturer', 'wedding-dress-manufacturer', 'bodysuit-manufacturer', 'suit-manufacturer', 'menswear-manufacturer', 'overalls-manufacturer', 'kurta-manufacturer', 'salwar-kameez-manufacturer', 'hijab-manufacturer', 'thobe-manufacturer', 'polyester-clothing-manufacturer', 'hemp-clothing-manufacturer', 'modal-clothing-manufacturer', 'french-terry-clothing-manufacturer', 'corduroy-clothing-manufacturer', 'wool-clothing-manufacturer', 'lyocell-clothing-manufacturer', 'velour-clothing-manufacturer', 'tie-dye-clothing-manufacturer', 'sublimated-clothing-manufacturer', 'adaptive-clothing-manufacturer', 'embroidery-service', 'printing-service', 'dyeing-service', 'washing-service', 'pattern-making-service', 'tech-pack-service', 'lab-dip-service', 'quality-inspection-service', 'fabric-sourcing', 'trims-sourcing', 'garment-labels', 'private-label-clothing-manufacturer', 'low-moq-clothing-manufacturers', 'clothing-manufacturers-for-startups', 'cut-and-sew-service', 'sample-service', 'silk-clothing-manufacturer', 'bathrobe-manufacturer', 'sustainable-clothing-manufacturer', 'organic-cotton-clothing-manufacturer', 'recycled-clothing-manufacturer', 'garment-development-service', 'garment-packing-and-export', 'viscose-clothing-manufacturer', 'nylon-clothing-manufacturer', 'chiffon-clothing-manufacturer', 'fleece-clothing-manufacturer', 'ripstop-clothing-manufacturer', 'jersey-knit-clothing-manufacturer', 'rib-knit-clothing-manufacturer', 'waffle-knit-clothing-manufacturer', 'ponte-clothing-manufacturer', 'scuba-fabric-clothing-manufacturer', 'mesh-clothing-manufacturer', 'spandex-clothing-manufacturer', 'acrylic-clothing-manufacturer', 'georgette-clothing-manufacturer', 'crepe-clothing-manufacturer', 'voile-clothing-manufacturer', 'chambray-clothing-manufacturer', 'flannel-clothing-manufacturer', 'gabardine-clothing-manufacturer', 'seersucker-clothing-manufacturer', 'jacquard-clothing-manufacturer', 'muslin-clothing-manufacturer', 'tweed-clothing-manufacturer', 'velvet-clothing-manufacturer', 'taffeta-clothing-manufacturer', 'custom-hang-tags', 'garment-polybags', 'garment-export-cartons', 'cricket-uniform-manufacturer', 'netball-dress-manufacturer', 'volleyball-uniform-manufacturer', 'hockey-jersey-manufacturer', 'american-football-jersey-manufacturer', 'bed-linen-manufacturer', 'towel-manufacturer', 'blanket-manufacturer', 'custom-zippers', 'custom-buttons', 'snap-buttons', 'custom-rivets', 'hook-and-loop-tape', 'garment-buckles', 'garment-elastic', 'custom-drawcords', 'garment-tapes', 'lace-trims', 'garment-interlining', 'sewing-thread', 'shoulder-pads', 'bra-components', 'garment-eyelets', 'custom-hangers', 'custom-tissue-paper', 'custom-clothing-boxes', 'custom-packaging-stickers', 'custom-mailer-bags']);
  const entries = (await getCollection('landing')).filter((entry) => !dedicated.has(entry.id));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'landing'>;
}

const { entry } = Astro.props;
const data = entry.data;
const path = `/${entry.id}/`;
const { Content, headings } = await render(entry);
const toc = data.kind === 'guide' ? headings.filter((h) => h.depth === 2) : [];
const citationUrls = [...data.citations, ...data.sources.map((s) => s.url)];

const hubs: Record<typeof data.hub, Crumb> = {
  products: { name: 'Products', path: '/products/' },
  services: { name: 'Services', path: '/all-services/' },
  'how-we-work': { name: 'How we work', path: '/work-process/' },
};

const title = fill(data.title);
const description = fill(data.description);
const h1 = fill(data.h1);
const answer = fill(data.answer);
const faqs = data.faq.map((item) => ({ q: fill(item.q), a: fill(item.a) }));
const specs = data.specs.map((row) => ({ label: fill(row.label), value: fill(row.value) }));
const crumbs: Crumb[] = [{ name: 'Home', path: '/' }, hubs[data.hub], { name: data.navLabel, path }];
const related = await linkCards(data.related);
const published = data.published.toISOString().slice(0, 10);
const updated = data.updated.toISOString().slice(0, 10);
const updatedHuman = data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = graph([
  organization(),
  founder(),
  website(),
  webPage({ path, title, description, datePublished: published, dateModified: updated, hasBreadcrumb: true, reviewed: true }),
  breadcrumbList(crumbs),
  data.kind === 'guide'
    ? article({ path, headline: h1, description, datePublished: published, dateModified: updated, citations: citationUrls })
    : service({ path, name: h1, description, serviceType: data.serviceType }),
  faqPage(path, faqs),
]);
---

<BaseLayout title={title} description={description} path={path} schema={schema} crumbs={crumbs}>
  <article class="landing">
    <header class="landing__hero container">
      <p class="eyebrow">{data.eyebrow}</p>
      <h1 class="landing__title">{h1}</h1>
      <p class="landing__answer">{answer}</p>
      <div class="landing__actions">
        <a class="button button--primary" href="/get-a-quote/">Get a quote</a>
        <a class="button button--secondary" href="/pricing/">See prices</a>
      </div>
      <FactStrip keys={data.facts} />
      <p class="landing__updated">
        Last updated <time datetime={updated}>{updatedHuman}</time> · Reviewed by <a href="/about/">{company.founder.name}</a>,
        {company.founder.jobTitle}
      </p>
    </header>

    {
      specs.length > 0 && (
        <section class="landing__section container" aria-labelledby="specs-heading">
          <h2 id="specs-heading">Specifications at a glance</h2>
          <div class="table-wrap" role="region" aria-labelledby="specs-heading" tabindex="0">
            <table>
              {data.specsCaption && <caption>{fill(data.specsCaption)}</caption>}
              <tbody>
                {specs.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>{row.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      data.showPrices && (
        <section class="landing__section container" aria-labelledby="prices-heading">
          <h2 id="prices-heading">Indicative prices</h2>
          <PriceTable />
        </section>
      )
    }

    {
      toc.length >= 6 && (
        <nav class="landing__section container toc" aria-labelledby="toc-heading">
          <h2 id="toc-heading" class="toc__heading">On this page</h2>
          <ol class="toc__list">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="landing__section container">
      <div class="prose">
        <Content />
      </div>
    </div>

    {
      data.sources.length > 0 && (
        <section class="landing__section container" aria-labelledby="sources-heading">
          <div class="prose">
            <h2 id="sources-heading">Sources</h2>
            <ul>
              {data.sources.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer">
                    {s.title}
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                  , {s.publisher}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <div class="landing__section container">
      <FaqList items={faqs} heading="Frequently asked questions" />
    </div>

    <div class="landing__section container">
      <RelatedLinks links={related} heading="Keep reading" />
    </div>

    {
      data.kind === 'guide' && (
        <section class="landing__section container" aria-labelledby="about-page-heading">
          <div class="prose">
            <h2 id="about-page-heading">About this page</h2>
            <p>
              Our merchandising team at {company.legalName} wrote this guide from our own production records and the sources listed above.{' '}
              <a href="/about/">{company.founder.name}</a>, {company.founder.jobTitle}, reviewed it. If you spot an error, tell us through our{' '}
              <a href="/contact/">contact page</a> and we will correct it.
            </p>
          </div>
        </section>
      )
    }
  </article>
  <CtaBand />
</BaseLayout>

<style>
  .landing__hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-7);
  }

  .landing__title {
    max-width: 22ch;
  }

  .landing__answer {
    max-width: 44rem;
    color: var(--color-text);
    font-size: var(--text-lg);
  }

  .landing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .landing__updated {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .landing__section {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  .toc {
    display: grid;
    gap: var(--space-3);
  }

  .toc__heading {
    font-size: var(--text-lg);
  }

  .toc__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-inline-start: var(--space-5);
  }

  .toc__list a {
    display: inline-block;
    min-height: 44px;
    padding-block: var(--space-2);
  }
</style>
