---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { capabilities, company, terms, yearsInBusiness } from '../data/company';
import { pageMeta } from '../data/pages';
import { standardPage, type Crumb } from '../lib/schema';

const meta = pageMeta('/about/');
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];
const years = yearsInBusiness();

const schema = standardPage({
  path: meta.path,
  title: meta.title,
  description: meta.description,
  dateModified: meta.updated,
  crumbs,
  type: 'AboutPage',
  fullOrganization: true,
});
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} schema={schema} crumbs={crumbs}>
  <PageHeader
    eyebrow="About us"
    title="About SDF Clothing"
    lead={`About SDF Clothing: we're a garment factory in Dhaka, Bangladesh, founded in ${company.foundingYear} and run by ${company.founder.name}. For ${years} years we've made T-shirts, hoodies and other clothes for brands. Today we focus on small and growing brands that want factory quality from ${terms.moq} ${terms.moqUnit}.`}
    updated={meta.updated}
  />

  <section class="section" aria-labelledby="who-heading">
    <div class="container split">
      <div class="section__head">
        <h2 id="who-heading">About SDF Clothing: who we are</h2>
        <p class="section__lead">{company.legalName} is a privately owned manufacturer with its office in {company.address.street}, Dhaka.</p>
      </div>
      <div class="prose">
        <p>
          We make cut-and-sew clothing under our customers' brands. Our merchandisers work directly with your team, in English, from the first quote to the
          final shipment. There is no buying house or agent between you and the production floor.
        </p>
        <h3>{company.founder.name}, {company.founder.jobTitle}</h3>
        <p>
          {company.founder.name}, our founder, set up the business in {company.foundingYear}. Today our focus is brands
          that need lower minimums, clear terms and straight answers.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="inhouse-heading">
    <div class="container split">
      <div class="section__head">
        <h2 id="inhouse-heading">Everything is made in our own factory</h2>
        <p class="section__lead">We don't pass work to subcontractors. Every step of your order happens under one roof in Dhaka, with our own team.</p>
        <p>Fabric: {capabilities.fabrics}.</p>
      </div>
      <ul class="checklist">
        {capabilities.inHouse.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="values-heading">
    <div class="container prose">
      <h2 id="values-heading">How we work with buyers</h2>
      <ul>
        <li><strong>Terms in writing.</strong> Price, minimum, lead time and payment schedule are on your quote before you pay anything.</li>
        <li><strong>Prices in public.</strong> Our <a href="/pricing/">price index</a> is dated and updated, so you can check a budget first.</li>
        <li><strong>Samples before bulk.</strong> You approve a proto and a pre-production sample before cutting.</li>
        <li><strong>Inspection you can check.</strong> Final AQL {terms.aql} report, and your own inspector is welcome.</li>
        <li><strong>Saying no.</strong> If a project is not a good fit for our lines, we tell you at the start.</li>
      </ul>
      <h2>Who we make for</h2>
      <p>
        We make clothing for brands in any country, from founders placing a first order to established labels
        launching a new capsule. Read how we work with <a href="/clothing-manufacturers-for-startups/">startup brands</a> and on
        <a href="/private-label-clothing-manufacturer/">private label programmes</a>, or learn more about
        <a href="/clothing-manufacturer-bangladesh/">manufacturing in Bangladesh</a>.
      </p>
      <h2>Company details</h2>
      <ul>
        <li><strong>Company name:</strong> {company.legalName}</li>
        <li><strong>Parent company:</strong> {company.parentCompany}</li>
        <li><strong>Founded:</strong> {company.foundingYear}</li>
        <li><strong>Address:</strong> {company.address.street}, {company.address.locality} {company.address.postalCode}, {company.address.countryName}</li>
        {company.showRegistration && <li><strong>RJSC registration:</strong> {company.registration.rjsc}</li>}
        <li><strong>Official website:</strong> {company.officialDomain}</li>
      </ul>
      <p>
        Before your first payment, please check our official details on the <a href="/verify-us/">verify page</a>. Our
        <a href="/faq/">clothing manufacturer FAQ</a> covers samples and payment, and our <a href="/nda/">clothing manufacturer NDA</a> page explains how we keep designs private.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
