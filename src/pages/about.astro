---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FactStrip from '../components/FactStrip.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { capabilities, company, designTeamFrom, exportMarkets, mainMarkets, shipping, sisterCompany, terms, workplace, yearsInBusiness } from '../data/company';
import { productParts, serviceGroups } from '../data/catalogue';
import { pageMeta } from '../data/pages';
import { faqPage, standardPage, type Crumb } from '../lib/schema';

const meta = pageMeta('/about/');
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];
const years = yearsInBusiness();
const large = (n: number) => n.toLocaleString('en-GB');

const sections = [
  { id: 'who', label: 'Who we are' },
  { id: 'mission', label: 'Mission and values' },
  { id: 'make', label: 'What we make' },
  { id: 'capabilities', label: 'Capabilities' },
  { id: 'people', label: 'Our people' },
  { id: 'operate', label: 'How we operate' },
  { id: 'trust', label: 'Why buyers trust us' },
  { id: 'details', label: 'Who we make for' },
];

const productLinks = productParts
  .filter((part) => part.id !== 'more')
  .map((part) => ({ href: `/products/#${part.id}`, title: part.heading, text: part.lead }));

const serviceLinks = serviceGroups.map((group) => ({ href: `/all-services/#${group.id}`, title: group.heading, text: group.activities ?? group.lead }));

const values = [
  { title: 'Put it in writing', text: 'Price, minimum, lead time and payment are agreed on paper before any money moves.' },
  { title: 'Make it ourselves', text: 'Cutting, sewing, printing and checks stay on our own floor, so we answer for every stage.' },
  { title: 'Every order counts', text: `A first run of ${terms.moq} pieces gets the same pattern work, checks and reports as our largest orders.` },
  { title: 'Show the work', text: 'Public prices, measurement reports, open factory visits and room for your own inspector.' },
  { title: 'Fix it before it ships', text: 'Problems are cheaper on a sample than in a carton, so we look for them early and say so plainly.' },
];

const faqs = [
  {
    q: 'Is SDF Clothing a factory or a trading company?',
    a: 'A factory. We cut, sew, print, embroider, inspect and pack in our own premises in Dhaka, and our merchandisers work with you directly.',
  },
  {
    q: 'Which company does SDF Clothing belong to?',
    a: `${company.legalName} is part of ${company.parentCompany}. Our sister company makes fabric for large orders, plus trims and garment accessories.`,
  },
  {
    q: 'Can I meet the team before ordering?',
    a: 'Yes. Factory visits in Dhaka are by appointment, and a merchandiser walks you through the production floor and your samples.',
  },
];

const schema = standardPage({
  path: meta.path,
  title: meta.title,
  description: meta.description,
  dateModified: meta.updated,
  crumbs,
  type: 'AboutPage',
  fullOrganization: true,
  extra: [faqPage(meta.path, faqs)],
});
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} schema={schema} crumbs={crumbs}>
  <PageHeader
    eyebrow="About us"
    title="About SDF Clothing"
    lead={`About SDF Clothing: we are a cut-and-sew clothing manufacturer in Dhaka, Bangladesh, making custom clothing for brands worldwide from ${terms.moq} ${terms.moqUnit}. ${company.founder.name} founded the business in ${company.foundingYear}, and for ${years} years everything has been made in our own factory.`}
    updated={meta.updated}
  >
    <FactStrip keys={['moq', 'sample', 'bulk', 'quote']} />
  </PageHeader>

  <nav class="hub-nav container" aria-label="On this page">
    <ul class="hub-nav__list">
      {
        sections.map((s) => (
          <li>
            <a class="hub-nav__link" href={`#${s.id}`}>
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <section class="section about-section" id="who" aria-labelledby="who-heading">
    <div class="container split">
      <div class="section__head">
        <h2 id="who-heading">About SDF Clothing: who we are</h2>
        <p class="section__lead">A privately owned clothing manufacturer and exporter in Dhaka, part of the {company.parentCompany} group.</p>
        <div class="table-wrap" role="region" aria-label="Company at a glance" tabindex="0">
          <table class="about-glance">
            <caption>SDF Clothing at a glance</caption>
            <tbody>
              <tr><th scope="row">Business type</th><td>Clothing manufacturer and exporter</td></tr>
              <tr><th scope="row">Founded</th><td>{company.foundingYear}, by {company.founder.name}</td></tr>
              <tr><th scope="row">Group</th><td>{company.parentCompany}</td></tr>
              <tr><th scope="row">Team</th><td>{capabilities.workforce} people</td></tr>
              <tr><th scope="row">Monthly capacity</th><td>About {large(capabilities.monthlyCapacity)} pieces</td></tr>
              <tr><th scope="row">Main markets</th><td>{exportMarkets.map((m) => m.replace(/^the /, '')).join(', ')}</td></tr>
              <tr><th scope="row">Location</th><td>{company.address.street}, {company.address.locality} {company.address.postalCode}, {company.address.countryName}</td></tr>
              <tr><th scope="row">Official website</th><td>{company.officialDomain}</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="prose">
        <p>
          We make clothing under our customers' brands, never our own. Our merchandisers work with your team in English, from the first quote to the final
          shipment. There is no buying house or agent between you and the production floor.
        </p>
        <h3>{company.founder.name}, {company.founder.jobTitle}</h3>
        <p>
          {company.founder.name} set up the business in {company.foundingYear} and still leads it today. His focus is brands that need lower minimums, clear
          terms and straight answers.
        </p>
        <h3>Our story</h3>
        <p>
          {company.founder.name} opened the business in Dhaka in {company.foundingYear} with one aim: make clothing that matches the sample, and ship it when
          promised. Over {years} years that simple rule has grown into a team of {capabilities.workforce} people and room for about
          {large(capabilities.monthlyCapacity)} pieces a month.
        </p>
        <p>
          Our main markets today are {mainMarkets()}, with buyers in many other countries too. Our focus today is growing brands that need factory standards
          without huge minimums.
        </p>
        <h3>Our group</h3>
        <p>
          Our sister company in the {company.parentCompany} group makes knit and woven fabric for orders from {large(sisterCompany.fabricAbove)} pieces per style.
          It also makes trims and garment accessories for the clothing we produce.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt about-section" id="mission" aria-labelledby="mission-heading">
    <div class="container">
      <div class="section__head">
        <h2 id="mission-heading">Our mission, vision and values</h2>
        <p class="section__lead">What we aim for, and the values behind how every order is quoted, made and shipped.</p>
      </div>
      <div class="about-pillars">
        <div class="about-pillar">
          <h3>Mission</h3>
          <p>To give growing brands the factory, terms and care that big labels get, from {terms.moq} {terms.moqUnit}.</p>
        </div>
        <div class="about-pillar">
          <h3>Vision</h3>
          <p>To be the factory brands stay with as they grow, because every order is made, checked and shipped the way we said it would be.</p>
        </div>
      </div>
      <h3 class="about-sub">Our values</h3>
      <ul class="cards">
        {
          values.map((v) => (
            <li class="card">
              <h4 class="card__title">{v.title}</h4>
              <p class="card__text">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section about-section" id="make" aria-labelledby="make-heading">
    <div class="container">
      <div class="section__head">
        <h2 id="make-heading">What we manufacture</h2>
        <p class="section__lead">Knit and woven clothing, accessories and home textiles, all cut and sewn to your pattern, fabric and labels.</p>
      </div>
      <ul class="cards">
        {
          productLinks.map((link) => (
            <li class="card">
              <h3 class="card__title">{link.title}</h3>
              <p class="card__text">{link.text}</p>
              <a class="card__link" href={link.href}>
                See our {link.title.toLowerCase()}
              </a>
            </li>
          ))
        }
      </ul>
      <h3 class="about-sub">Our services</h3>
      <ul class="about-services">
        {
          serviceLinks.map((link) => (
            <li>
              <a href={link.href}>{link.title}</a>
              <span>{link.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt about-section" id="capabilities" aria-labelledby="cap-heading">
    <div class="container split">
      <div class="section__head">
        <h2 id="cap-heading">Our manufacturing capabilities</h2>
        <p class="section__lead">We do not pass work to subcontractors. Every step of your order happens under one roof in Dhaka, with our own team.</p>
        <p>Fabric: {capabilities.fabrics}.</p>
      </div>
      <div>
        <ul class="checklist">
          {capabilities.inHouse.map((item) => <li>{item}</li>)}
        </ul>
        <div class="table-wrap" role="region" aria-label="Capability figures" tabindex="0">
          <table>
            <caption>Capability figures</caption>
            <tbody>
              <tr><th scope="row">Minimum order</th><td>{terms.moq} {terms.moqUnit}</td></tr>
              <tr><th scope="row">Proto sample</th><td>{terms.sampleDays} days, door to door</td></tr>
              <tr><th scope="row">Bulk production</th><td>{terms.bulkDays} days after sample approval</td></tr>
              <tr><th scope="row">T-shirt fabric weight</th><td>{capabilities.tshirtGsm} GSM</td></tr>
              <tr><th scope="row">Fleece fabric weight</th><td>{capabilities.fleeceGsm} GSM</td></tr>
              <tr><th scope="row">In-house design team</th><td>Orders from {large(designTeamFrom)} pieces per style</td></tr>
              <tr><th scope="row">Final inspection</th><td>AQL {terms.aql}</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section about-section" id="people" aria-labelledby="people-heading">
    <div class="container split">
      <div class="section__head">
        <h2 id="people-heading">Our factory and people</h2>
        <p class="section__lead">
          Every garment we ship is made by our own team of {capabilities.workforce} people. These are the basics each of them can count on.
        </p>
        <p>Buyers and their auditors can see all of this on a <a href="/booking/">garment factory visit</a>.</p>
      </div>
      <ul class="checklist checklist--notes">
        {
          workplace.map((item) => (
            <li>
              <strong>{item.label}.</strong> {item.text.charAt(0).toUpperCase() + item.text.slice(1)}.
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt about-section" id="operate" aria-labelledby="operate-heading">
    <div class="container split">
      <div class="section__head">
        <h2 id="operate-heading">Where and how we operate</h2>
        <p class="section__lead">
          Our office and factory are in {company.address.locality}. We ship {terms.incoterm} {terms.port}, or on the terms you choose, to buyers in every region
          below.
        </p>
        <p>Working hours: {company.hours}.</p>
      </div>
      <ul class="checklist checklist--notes">
        {
          shipping.regions.map((region) => (
            <li>
              <strong>{region.name}.</strong> {region.note}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="container prose about-steps">
      <p>
        Every order follows the same path: written quote, sample, approval, bulk, inspection and shipment. Our <a href="/work-process/">clothing production process</a>
        page shows the timing and payment for each step, and our <a href="/garment-packing-and-export/">garment packing and export</a> page covers documents and
        shipping.
      </p>
    </div>
  </section>

  <section class="section about-section" id="trust" aria-labelledby="trust-heading">
    <div class="container prose">
      <h2 id="trust-heading">Why buyers trust us</h2>
      <ul>
        <li><strong>Terms in writing.</strong> Price, minimum, lead time and payment schedule are on your quote before you pay anything.</li>
        <li><strong>Prices in public.</strong> Our <a href="/pricing/">clothing manufacturing prices</a> are dated and updated, so you can check a budget first.</li>
        <li><strong>Samples before bulk.</strong> You approve a proto and a pre-production sample before cutting, with up to {terms.sampleCorrections} free correction rounds.</li>
        <li><strong>Inspection you can check.</strong> Final AQL {terms.aql} report, and your own inspector is welcome.</li>
        <li><strong>Open doors.</strong> Buyers can <a href="/booking/">book a garment factory visit</a> and see the floor for themselves.</li>
        <li><strong>Your designs stay private.</strong> We sign a <a href="/nda/">clothing manufacturer NDA</a> before you share files, if you ask.</li>
        <li><strong>Saying no.</strong> If a project is not a good fit for our lines, we tell you at the start.</li>
      </ul>
      <p>
        Read how we handle <a href="/certifications/">clothing factory compliance</a> and buyer audits, and how to <a href="/verify-us/">verify SDF Clothing</a> before
        your first payment.
      </p>
    </div>
  </section>

  <section class="section section--alt about-section" id="details" aria-labelledby="details-heading">
    <div class="container prose">
      <h2 id="details-heading">Who we make for</h2>
      <p>
        Founders placing a first order, and established labels launching a new capsule or moving production. See how we work with
        <a href="/clothing-manufacturers-for-startups/">startup brands</a> and on <a href="/private-label-clothing-manufacturer/">private label programmes</a>, or
        read our guide to <a href="/clothing-manufacturer-bangladesh/">manufacturing in Bangladesh</a>. Quick answers are in our
        <a href="/faq/">clothing manufacturer FAQ</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <FaqList items={faqs} heading="Questions about our company" />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .about-section {
    scroll-margin-top: var(--header-height);
  }

  .about-sub {
    margin: var(--space-7) 0 var(--space-3);
  }

  .about-services {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-services li {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-line);
  }

  .about-services a {
    font-weight: 600;
  }

  .about-pillars {
    display: grid;
    gap: var(--space-4);
  }

  .about-pillar {
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--color-accent-strong);
    border-radius: var(--radius-md);
  }

  .about-pillar h3 {
    margin: 0 0 var(--space-2);
    color: var(--color-accent);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-pillar p {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-lg);
  }

  .about-glance {
    margin-top: var(--space-4);
  }

  .about-steps {
    margin-top: var(--space-6);
  }

  .table-wrap {
    margin-top: var(--space-5);
  }

  @media (min-width: 48rem) {
    .about-pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }
</style>
