---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import VisitForm from '../components/VisitForm.astro';
import FaqList from '../components/FaqList.astro';
import { company, terms } from '../data/company';
import { pageMeta } from '../data/pages';
import { faqPage, standardPage, type Crumb } from '../lib/schema';

const meta = pageMeta('/booking/');
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
  { name: 'Book a factory visit', path: '/booking/' },
];

const faqs = [
  {
    q: 'How far ahead should I book a factory visit?',
    a: 'Give us as much notice as you can, ideally two weeks, so the right merchandiser and production staff are available and your samples can be ready on the day.',
  },
  {
    q: 'What will I see during the visit?',
    a: 'You can see pattern making, cutting, sewing, screen printing, embroidery, finishing and quality inspection, and review samples or fabrics for your own order with your merchandiser.',
  },
  {
    q: 'Do I need to place an order before visiting?',
    a: 'No. Many buyers visit before their first order to see the factory and meet the team. If you already have a quote, mention the reference so we can prepare.',
  },
  {
    q: 'Can my quality inspector visit instead of me?',
    a: 'Yes. Third-party inspectors are welcome for pre-shipment inspections. Choose "Pre-shipment inspection" as the purpose and tell us the inspection company.',
  },
];

const schema = standardPage({
  path: meta.path,
  title: meta.title,
  description: meta.description,
  dateModified: meta.updated,
  crumbs,
  extra: [faqPage(meta.path, faqs)],
});
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} schema={schema} crumbs={crumbs} showMobileCta={false}>
  <PageHeader
    eyebrow="Factory visit"
    title="Book a visit to our garment factory in Dhaka"
    lead={`Seeing the production floor helps you judge a manufacturer. Visit our garment factory in ${company.address.locality} to watch your kind of product being cut, sewn and inspected, review samples with your merchandiser and agree the next steps in person.`}
    updated={meta.updated}
  />

  <section class="section booking" aria-labelledby="form-heading">
    <div class="container booking__inner">
      <div>
        <h2 id="form-heading" class="block-heading">Request a visit</h2>
        <VisitForm />
      </div>
      <aside class="booking__aside" aria-labelledby="expect-heading">
        <h2 id="expect-heading" class="block-heading">What to expect</h2>
        <ul class="checklist">
          <li>A merchandiser meets you and stays with you throughout the visit</li>
          <li>A walk through cutting, sewing, printing, embroidery and inspection</li>
          <li>Time to review samples, fabrics and trims for your order</li>
          <li>A written summary of what was agreed, sent after the visit</li>
        </ul>
        <div class="notice">
          <p>
            <strong>Where we are:</strong>
            {company.address.street}, {company.address.locality}
            {company.address.postalCode}. We send directions and a contact number for the day when we confirm your date.
          </p>
        </div>
        <p class="booking__small">
          We reply within {terms.replyHours} working hours. Not ready to travel? Start with a <a href="/get-a-quote/">quote request</a> or a paid
          <a href="/sample-service/">sample</a>.
        </p>
      </aside>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="prepare-heading">
    <div class="container prose">
      <h2 id="prepare-heading">How to get the most from your visit</h2>
      <ol>
        <li><strong>Bring your references:</strong> a tech pack, reference garments or photos of the product you want to make.</li>
        <li><strong>Share your quantities and target price</strong> so we can talk through fabric and construction options that fit.</li>
        <li><strong>Plan time for samples:</strong> if you have an approved sample, bring it so we can compare it with fabric and trims on the day.</li>
        <li><strong>Ask anything:</strong> how we check quality, how payments work and how we keep bulk the same as the sample.</li>
      </ol>
      <p>
        Before you travel, read how our <a href="/work-process/">production process</a> works and check our <a href="/verify-us/">official contacts</a>, so you
        know exactly who to expect.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <FaqList items={faqs} heading="Factory visit questions" />
    </div>
  </section>
</BaseLayout>

<style>
  .booking {
    padding-top: 0;
  }

  .booking__inner {
    display: grid;
    gap: var(--space-7);
  }

  .booking__aside {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .booking__small {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 64rem) {
    .booking__inner {
      grid-template-columns: 1.5fr 1fr;
    }
  }
</style>
