---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { terms } from '../data/company';
import { pageMeta } from '../data/pages';
import { faqPage, standardPage, type Crumb } from '../lib/schema';

const meta = pageMeta('/certifications/');
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'How we work', path: '/work-process/' },
  { name: 'Compliance and audits', path: '/certifications/' },
];

const faqs = [
  {
    q: 'Can I see your compliance documents?',
    a: 'Yes. We share our compliance documents with buyers once an order is in development, so they go to the people who will rely on them.',
  },
  {
    q: 'Can I send my own inspector?',
    a: 'Yes. Book SGS, Intertek, QIMA, Bureau Veritas or any inspector you trust. Tell us the date and we make the goods, packing list and our own inspection report available.',
  },
  {
    q: 'Do you allow buyer audits of the factory?',
    a: 'Yes. Audits are arranged during order development. Share the audit standard you use and we agree a date and scope with you.',
  },
  {
    q: 'Which inspection standard do you use?',
    a: `Our final inspection follows AQL ${terms.aql} for major defects, on a sample drawn from the finished, packed lot. If your brand uses a different AQL level, tell us at the quote stage.`,
  },
];

const schema = standardPage({
  path: meta.path,
  title: meta.title,
  description: meta.description,
  dateModified: meta.updated,
  crumbs,
  extra: [faqPage(meta.path, faqs)],
});
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} schema={schema} crumbs={crumbs}>
  <PageHeader
    eyebrow="Compliance and audits"
    title="How we handle compliance, audits and inspection"
    lead="Clothing factory compliance and audits should protect the buyer, not fill a web page with logos. We share compliance documents with buyers during order development, welcome buyer audits, and invite you to send your own inspector before any shipment leaves Dhaka."
    updated={meta.updated}
  />

  <section class="section" aria-labelledby="approach-heading">
    <div class="container split">
      <div class="section__head">
        <h2 id="approach-heading">Our approach</h2>
        <p class="section__lead">Documents are only useful to the people who will rely on them, so we share them during development rather than publish them.</p>
      </div>
      <ul class="checklist">
        <li><strong>Compliance documents</strong> shared with buyers once an order is in development</li>
        <li><strong>Buyer audits</strong> arranged on request, to the standard your brand uses</li>
        <li><strong>Third-party inspection</strong> by your chosen inspector before shipment</li>
        <li><strong>Our own final inspection</strong> to AQL {terms.aql}, report shared with you</li>
        <li><strong>Destination labelling</strong> for fibre content, care and origin in your market</li>
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="quality-heading">
    <div class="container prose">
      <h2 id="quality-heading">How quality is checked on every order</h2>
      <ol>
        <li><strong>Lab dip approval</strong> before fabric is dyed.</li>
        <li><strong>Bulk fabric tests</strong> for weight, shrinkage and shade before cutting.</li>
        <li><strong>Pre-production sample</strong> in bulk fabric, signed off by you.</li>
        <li><strong>Inline checks</strong> on measurements and stitching during sewing.</li>
        <li><strong>Final AQL {terms.aql} inspection</strong> on the finished, packed goods.</li>
      </ol>
      <p>
        These steps are explained in context on our <a href="/work-process/">production process page</a> and on the
        <a href="/cut-and-sew-service/">cut-and-sew service page</a>.
      </p>
      <h2>Labelling for your market</h2>
      <p>
        Care and content labels are produced to the rules of your destination market, such as fibre content, care symbols and country of origin. We confirm
        the wording with you during sampling, so your goods clear customs and meet retail rules on arrival.
      </p>
      <h2>Before you send a payment</h2>
      <p>
        Compliance starts with knowing you are dealing with the real company. Check our official contacts and registration on the
        <a href="/verify-us/">verify page</a> before your first payment.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <FaqList items={faqs} heading="Compliance and audit questions" />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
