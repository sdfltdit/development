---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { company, customerId, terms, whatsappUrl } from '../data/company';
import { pageMeta } from '../data/pages';
import { standardPage, type Crumb } from '../lib/schema';

const meta = pageMeta('/contact/');
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
const mapsLink = `https://maps.google.com/?q=${company.geo.latitude},${company.geo.longitude}`;

const schema = standardPage({
  path: meta.path,
  title: meta.title,
  description: meta.description,
  dateModified: meta.updated,
  crumbs,
  type: 'ContactPage',
});
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} schema={schema} crumbs={crumbs}>
  <PageHeader
    eyebrow="Contact"
    title="Contact SDF Clothing"
    lead={`Contact SDF Clothing through the form below, and our customer care team will reply within ${terms.replyHours} working hours. Our WhatsApp line is an automated assistant for quick questions. For a price, the quote form is fastest: you get a written quote within ${terms.quoteHours} hours.`}
    updated={meta.updated}
  />

  <section class="section contact" aria-labelledby="form-heading">
    <div class="container contact__inner">
      <div>
        <h2 id="form-heading" class="block-heading">Send us a message</h2>
        <ContactForm />
      </div>
      <aside class="contact__aside" aria-labelledby="other-heading">
        <h2 id="other-heading" class="block-heading">Other ways to contact SDF Clothing</h2>
        <ul class="cards cards--stack">
          <li class="card">
            <h3 class="card__title">Get a quote</h3>
            <p class="card__text">Product, quantity and target price in one form. Written quote within {terms.quoteHours} hours.</p>
            <a class="card__link" href="/get-a-quote/">Request a quote</a>
          </li>
          <li class="card">
            <h3 class="card__title">WhatsApp assistant</h3>
            <p class="card__text">Quick answers from our automated assistant. For orders, payments and changes, use the form.</p>
            <a class="card__link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Ask our WhatsApp assistant<span class="visually-hidden"> (opens in a new tab)</span></a>
          </li>
          <li class="card">
            <h3 class="card__title">Factory visit</h3>
            <p class="card__text">See the production floor in person. Choose your dates and we confirm a time.</p>
            <a class="card__link" href="/booking/">Book a factory visit</a>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="customer-id-heading">
    <div class="container prose">
      <h2 id="customer-id-heading">Your customer ID</h2>
      <p>
        Our customer care team answers every message sent through this page, with or without a customer ID. New enquiries, quotes and questions before you
        order all start here.
      </p>
      <p>
        {customerId.policy} Quote it in every message about your order. It keeps your records together and stops anyone else posing as you, or as us.
      </p>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="office-heading">
    <div class="container split">
      <div class="section__head">
        <h2 id="office-heading">Office address</h2>
        <address class="contact-address">
          {company.legalName}<br />
          {company.address.street}<br />
          {company.address.locality} {company.address.postalCode}<br />
          {company.address.countryName}
        </address>
        <p><a href={mapsLink} target="_blank" rel="noopener noreferrer">Open in Google Maps<span class="visually-hidden"> (opens in a new tab)</span></a></p>
      </div>
      <div class="prose">
        <h3>Visiting us</h3>
        <p>
          Factory visits are welcome by appointment. <a href="/booking/">Book your visit online</a> with your preferred dates, and a merchandiser will meet you
          and walk you through the production floor.
        </p>
        <h3>Check it is really us</h3>
        <p>
          Our only website is {company.officialDomain}, we only email from @{company.officialDomain} addresses, and we only accept payment to our company bank
          account. See the <a href="/verify-us/">verify page</a> for details. Quick answers on samples and payment are in our
          <a href="/faq/">clothing manufacturer FAQ</a>, and we sign a <a href="/nda/">clothing manufacturer NDA</a> on request.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-top: 0;
  }

  .contact__inner {
    display: grid;
    gap: var(--space-7);
  }

  .contact__aside {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .contact-address {
    font-size: var(--text-lg);
    font-style: normal;
  }

  @media (min-width: 64rem) {
    .contact__inner {
      grid-template-columns: 1.5fr 1fr;
    }
  }
</style>
