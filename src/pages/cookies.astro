---
import ProsePage from '../components/ProsePage.astro';
import { company } from '../data/company';
---

<ProsePage
  path="/cookies/"
  crumbLabel="Cookies"
  eyebrow="Legal"
  heading="SDF Clothing cookie policy"
  lead={`The SDF Clothing cookie policy is short. ${company.officialDomain} uses no ad or tracking cookies. Here is all the site stores in your browser, and why.`}
>
  <h2>What the site stores</h2>
  <div class="table-wrap" role="region" aria-label="Browser storage used by this site" tabindex="0">
    <table class="table--stack">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Type</th>
          <th scope="col">Purpose</th>
          <th scope="col">Duration</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">cf_clearance</th>
          <td data-label="Type">Cookie (Cloudflare)</td>
          <td data-label="Purpose">Set only if Cloudflare's security check runs, to confirm you passed it</td>
          <td data-label="Duration">Up to 30 minutes, or as set by Cloudflare</td>
        </tr>
        <tr>
          <th scope="row">Turnstile</th>
          <td data-label="Type">Session storage and cookies (Cloudflare)</td>
          <td data-label="Purpose">Set only on pages with the quote form, to tell people from bots</td>
          <td data-label="Duration">Session</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>Why there is no cookie banner</h2>
  <p>
    Everything listed above is needed for the site to work safely. Our analytics tool, Cloudflare Web Analytics, uses no cookies. We use no optional
    cookies, so there is nothing to consent to.
  </p>

  <h2>If the SDF Clothing cookie policy changes</h2>
  <p>
    If we ever add optional cookies, such as for ads or detailed analytics, we will ask you first and update this page. See our
    <a href="/privacy/">privacy policy</a> for how we handle personal information.
  </p>

  <h2>Clearing storage</h2>
  <p>You can clear cookies and site data at any time in your browser settings. The site will keep working as normal.</p>
  <ul>
    <li><strong>Chrome and Edge:</strong> open Settings, then Privacy, and choose to clear browsing data or site data.</li>
    <li><strong>Firefox:</strong> open Settings, then Privacy and Security, and manage cookies and site data.</li>
    <li><strong>Safari:</strong> open Settings or Preferences, then Privacy, and manage website data.</li>
  </ul>
</ProsePage>
