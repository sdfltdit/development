---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { company, sampleFeePolicy, terms, whatsappUrl } from '../data/company';
import { pageMeta } from '../data/pages';
import { standardPage, type Crumb } from '../lib/schema';

const meta = pageMeta('/get-a-quote/');
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Get a quote', path: '/get-a-quote/' },
];

const schema = standardPage({
  path: meta.path,
  title: meta.title,
  description: meta.description,
  dateModified: meta.updated,
  crumbs,
  type: 'ContactPage',
});
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} schema={schema} crumbs={crumbs}>
  <PageHeader
    eyebrow="Request a quote"
    title="Get a clothing manufacturing quote"
    lead={`Tell us what you want to make and you get a clothing manufacturing quote in writing within ${terms.quoteHours} hours. It shows the ${terms.incoterm} price per piece, colour and size split and lead time, from the factory itself.`}
  />

  <section class="section quote-layout">
    <div class="container quote-layout__inner">
      <div class="quote-layout__form">
        <h2 class="block-heading">Your request</h2>
        <QuoteForm />
      </div>
      <aside class="quote-layout__aside" aria-labelledby="next-heading">
        <h2 id="next-heading" class="block-heading">After you ask for a clothing manufacturing quote</h2>
        <ol class="next-steps">
          <li>A merchandiser reads your request and may ask one or two questions.</li>
          <li>You receive a written quote within {terms.quoteHours} hours.</li>
          <li>If it works for you, we send fabric options and a sample timeline.</li>
          <li>You pay the deposit and we start your sample. {sampleFeePolicy}.</li>
        </ol>
        <div class="notice">
          <p>
            <strong>Prefer to meet in person?</strong> <a href="/booking/">Book a garment factory visit in Dhaka</a>.
          </p>
        </div>
        <div class="notice">
          <p>
            <strong>Quick question?</strong> <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Ask our automated WhatsApp assistant<span class="visually-hidden"> (opens in a new tab)</span></a> or
            <a href={company.contactPath}>contact SDF Clothing</a> with a message.
          </p>
        </div>
        <p class="quote-layout__small">
          Our minimum is {terms.moq} {terms.moqUnit}. See our <a href="/pricing/">clothing manufacturing prices</a> and <a href="/work-process/">clothing production process</a> before you
          send, and <a href="/verify-us/">verify SDF Clothing</a> through our official contacts.
        </p>
      </aside>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="include-heading">
    <div class="container prose">
      <h2 id="include-heading">What to put in your request</h2>
      <p>The more you tell us, the closer the first price is to the final one. You do not need a tech pack to start.</p>
      <div class="table-wrap" role="region" aria-label="What to include" tabindex="0">
        <table class="table--stack">
          <caption>What to include, and why it matters</caption>
          <thead>
            <tr><th scope="col">Detail</th><th scope="col">Why we ask</th></tr>
          </thead>
          <tbody>
            <tr><td data-label="Detail">Product and a photo or sketch</td><td data-label="Why we ask">Sets the pattern, sewing time and trims</td></tr>
            <tr><td data-label="Detail">Fabric and weight</td><td data-label="Why we ask">Fabric is usually the largest part of the price</td></tr>
            <tr><td data-label="Detail">Colours and print or embroidery</td><td data-label="Why we ask">Changes dye lots and decoration cost</td></tr>
            <tr><td data-label="Detail">Sizes and quantity per style</td><td data-label="Why we ask">Sets the price tier and the colour and size split</td></tr>
            <tr><td data-label="Detail">Target price and date</td><td data-label="Why we ask">Lets us suggest changes that meet both</td></tr>
          </tbody>
        </table>
      </div>
      <p>
        Not sure about fabric or weight? Describe the feel you want, or name a garment you like, and we suggest options. A rough request still gets a real price, which we refine once the details are agreed. Our free
        <a href="/tools/manufacturer-email-generator/">manufacturer email generator</a> helps you put a brief together.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .quote-layout {
    padding-top: 0;
  }

  .quote-layout__inner {
    display: grid;
    gap: var(--space-7);
  }

  .quote-layout__aside {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .next-steps {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-left: 1.25rem;
  }

  .quote-layout__small {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 64rem) {
    .quote-layout__inner {
      grid-template-columns: 1.6fr 1fr;
    }

    .quote-layout__aside {
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
    }
  }
</style>
