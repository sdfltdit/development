---
import HubPage from '../../components/HubPage.astro';
import { guideGroups } from '../../data/catalogue';
import { terms } from '../../data/company';

const faqs = [
  {
    q: 'Who writes these guides?',
    a: 'Our own team, from what we see on the factory floor every day. Each guide shows who reviewed it and where its facts come from.',
  },
  {
    q: 'Are the guides only about SDF Clothing?',
    a: 'No. They explain how clothing manufacturing works in general, so they help whichever factory you choose. Each one ends with a short note on where we fit.',
  },
  {
    q: 'How often are the guides updated?',
    a: 'When the facts change, such as trade rules or trade terms, and at least once a year. Each guide shows the date it was last updated.',
  },
  {
    q: 'Can I suggest a topic?',
    a: 'Yes. Send it through our contact form. Questions buyers ask us often become new guides.',
  },
];
---

<HubPage
  path="/insights/"
  hub="guides"
  crumbLabel="Guides"
  eyebrow="Guides"
  heading="Clothing manufacturing guides for brands"
  lead="These clothing manufacturing guides explain how to start a brand, find a factory, develop samples, control quality, price an order and ship it. They are written from our own factory floor in plain English, with the sources behind each fact."
  groups={guideGroups}
  faqs={faqs}
  faqHeading="Questions about our guides"
>
  <h2>How to use these clothing manufacturing guides</h2>
  <p>
    New to manufacturing? Start with <a href="/how-to-start-a-clothing-brand/">how to start a clothing brand</a>, then
    <a href="/how-to-find-clothing-manufacturer/">how to find a clothing manufacturer</a>. When you are ready to plan numbers, our free
    <a href="/tools/">clothing manufacturing tools</a> turn the guides into calculations.
  </p>
  <p>
    When you want real prices and dates for your own product, send a photo or tech pack through the <a href="/get-a-quote/">quote form</a>. You get a
    written quote within {terms.quoteHours} hours.
  </p>
</HubPage>
