---
import HubPage from '../components/HubPage.astro';
import { productGroups } from '../data/catalogue';
import { terms } from '../data/company';

const faqs = [
  {
    q: 'Can you make a product that is not listed?',
    a: 'Often, yes. We make knit, woven and flat-knit garments of almost every kind. Describe it in your quote request and we confirm whether it fits our lines before you pay anything.',
  },
  {
    q: 'Is the minimum the same for every product?',
    a: `Yes. Every product starts at ${terms.moq} ${terms.moqUnit}, and the split across colours and sizes is confirmed on your quote.`,
  },
  {
    q: 'Can I order several products in one shipment?',
    a: 'Yes. Each style needs its own minimum, but tees, hoodies, bags and accessories can be produced together and shipped as one consignment.',
  },
  {
    q: 'Do you sell stock or blank garments?',
    a: 'No. Every piece is cut and sewn for your order, to your fit, fabric and labels. We do not hold stock.',
  },
  {
    q: 'Where do I start if I am not sure what to make?',
    a: 'Start with one or two core styles your customers already ask for, such as a tee and a hoodie. Our guide on how to start a clothing brand walks through the first collection.',
  },
];
---

<HubPage
  path="/products/"
  hub="products"
  crumbLabel="Products"
  eyebrow="What we make"
  heading="Custom clothing products we manufacture"
  lead={`These are the custom clothing products we make in our Dhaka factory for brands worldwide, grouped by type. Every product is cut and sewn to your fit and fabric from ${terms.moq} ${terms.moqUnit}, with printing and embroidery in-house. Pick a group below to jump straight to it.`}
  groups={productGroups}
  faqs={faqs}
  faqHeading="Questions about our products"
>
  <h2>How to choose from our custom clothing products</h2>
  <p>
    Most brands start from the garment, such as a hoodie or a dress. Others start from the fabric, such as organic cotton or linen, or from the way they want
    to work, such as private label or a small first order. Each page sets out fabrics, weights, minimums and sample times, so you can compare before you ask.
  </p>
  <p>
    Prices for core products are on our <a href="/pricing/">clothing manufacturing prices</a> page. For everything else, send a photo or tech pack through the
    <a href="/get-a-quote/">quote form</a> and you get a written quote within {terms.quoteHours} hours.
  </p>
</HubPage>
