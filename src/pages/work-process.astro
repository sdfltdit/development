---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FactStrip from '../components/FactStrip.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { paymentSummary, terms } from '../data/company';
import { pageMeta } from '../data/pages';
import { faqPage, standardPage, type Crumb } from '../lib/schema';

const meta = pageMeta('/work-process/');
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'How we work', path: '/work-process/' },
];

const steps = [
  {
    title: 'Brief and quote',
    time: `Reply within ${terms.quoteHours} hours`,
    you: 'Send a tech pack or reference photo, fabric, quantity per style, decoration and target price.',
    we: `Send a written ${terms.incoterm} quote with price, sample fee, colour and size split and lead time.`,
  },
  {
    title: 'Fabric and colour',
    time: 'Depends on fabric availability',
    you: 'Approve fabric swatches and the lab dip.',
    we: 'Source the fabric and dye a lab dip matched to your Pantone or physical swatch.',
  },
  {
    title: 'Proto sample',
    time: `${terms.sampleDays} days`,
    you: 'Measure, wash and wear the sample, then send written comments.',
    we: 'Make the pattern and sample and send it with a measurement report.',
  },
  {
    title: 'Pre-production sample',
    time: 'Before cutting starts',
    you: 'Sign off the sample in writing. It becomes the reference for bulk.',
    we: 'Make the sample in bulk fabric with your labels and trims.',
  },
  {
    title: 'Bulk production',
    time: `${terms.bulkDays} days`,
    you: 'Review progress photos and answer any questions from your merchandiser.',
    we: 'Cut, sew, decorate and finish, with inline checks on measurements and stitching.',
  },
  {
    title: 'Final inspection',
    time: 'Before shipment',
    you: 'Review the report, or book your own inspector.',
    we: `Inspect a sample of the finished lot to AQL ${terms.aql} and share the report.`,
  },
  {
    title: 'Shipment',
    time: 'After final payment',
    you: 'Nominate your freight forwarder.',
    we: `Deliver the goods ${terms.incoterm} ${terms.port} with the commercial invoice, packing list and certificate of origin.`,
  },
];

const faqs = [
  {
    q: 'How long does the whole process take?',
    a: `Allow for the quote, fabric sourcing, a proto sample (${terms.sampleDays} days), the pre-production sample and bulk (${terms.bulkDays} days), then freight. Fabric availability and how quickly you approve samples are the two biggest variables.`,
  },
  {
    q: 'When do I pay?',
    a: `In three stages, one after the other: ${paymentSummary()}. You never pay for bulk before you have approved a sample.`,
  },
  {
    q: 'What does FOB mean for me?',
    a: `FOB (free on board) means we deliver the goods, cleared for export, onto your nominated vessel at ${terms.port}. From that point your forwarder handles freight, insurance, import duty and delivery.`,
  },
  {
    q: 'What happens if bulk does not match the approved sample?',
    a: 'The pre-production sample you signed is the reference. Any defects found in the final inspection are reworked or replaced before shipment, at our cost.',
  },
];

const schema = standardPage({
  path: meta.path,
  title: meta.title,
  description: meta.description,
  dateModified: meta.updated,
  crumbs,
  extra: [faqPage(meta.path, faqs)],
});
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} schema={schema} crumbs={crumbs}>
  <PageHeader
    eyebrow="Production process"
    title="How our clothing production process works"
    lead={`Our clothing production process runs in seven steps, and you sign off fabric, colour and two samples before any bulk piece is cut. Here is what happens at each step, how long it takes, what we need from you and when you pay.`}
    updated={meta.updated}
  >
    <FactStrip keys={['quote', 'sample', 'bulk', 'aql']} />
  </PageHeader>

  <section class="section" aria-labelledby="steps-heading">
    <div class="container">
      <h2 id="steps-heading" class="visually-hidden">The seven steps</h2>
      <ol class="process">
        {
          steps.map((step, index) => (
            <li class="process__step">
              <div class="process__head">
                <span class="process__num" aria-hidden="true">
                  {index + 1}
                </span>
                <h3 class="process__title">{step.title}</h3>
                <p class="process__time">{step.time}</p>
              </div>
              <dl class="process__roles">
                <div>
                  <dt>You</dt>
                  <dd>{step.you}</dd>
                </div>
                <div>
                  <dt>We</dt>
                  <dd>{step.we}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="payment-heading">
    <div class="container split">
      <div class="section__head">
        <h2 id="payment-heading">Payment schedule</h2>
        <p class="section__lead">Three stages, each tied to something you can see. You never pay for bulk before approving a sample.</p>
        <p>{terms.paymentMethod}. If anyone asks you to pay a different account, stop and check our <a href="/verify-us/">verify page</a>.</p>
      </div>
      <div class="table-wrap" role="region" aria-labelledby="payment-heading" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col">Step</th>
              <th scope="col">When</th>
              <th scope="col">Share of order value</th>
            </tr>
          </thead>
          <tbody>
            {
              terms.payment.map((p, i) => (
                <tr>
                  <th scope="row">{i + 1}</th>
                  <td>{p.when.charAt(0).toUpperCase() + p.when.slice(1)}</td>
                  <td>{p.share}%</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="letter-of-credit" aria-labelledby="lc-heading">
    <div class="container prose">
      <h2 id="lc-heading">Paying by letter of credit</h2>
      <p>You can pay by {terms.lc.summary}. These are our standard LC terms. Anything different is agreed in writing before your bank issues the credit.</p>
      <ul>
        {terms.lc.rules.map((rule) => <li>{rule}.</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="docs-heading">
    <div class="container prose">
      <h2 id="docs-heading">Documents you receive</h2>
      <ul>
        <li><strong>Written quote</strong> with price, sample fee, quantity split and lead time</li>
        <li><strong>Proforma invoice</strong> naming our company bank account</li>
        <li><strong>Measurement report</strong> with every sample</li>
        <li><strong>Final inspection report</strong> before shipment</li>
        <li><strong>Commercial invoice, packing list and certificate of origin</strong> for your forwarder</li>
      </ul>
      <p>
        Ready to start? Send your brief through the <a href="/get-a-quote/">quote form</a>, or read how our <a href="/sample-service/">sampling</a> and
        <a href="/cut-and-sew-service/">cut-and-sew production</a> work in detail.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <FaqList items={faqs} heading="Process questions" />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .process {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process__step {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .process__head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: var(--space-3);
  }

  .process__num {
    display: grid;
    grid-row: span 2;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-accent-strong);
    border-radius: 50%;
    color: var(--color-ink);
    font-weight: 600;
  }

  .process__title {
    font-size: var(--text-lg);
  }

  .process__time {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .process__roles {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .process__roles dt {
    color: var(--color-ink);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .process__roles dd {
    margin: 0;
    color: var(--color-text);
  }

  @media (min-width: 48rem) {
    .process__step {
      grid-template-columns: 18rem 1fr;
      align-items: start;
    }

    .process__roles {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
